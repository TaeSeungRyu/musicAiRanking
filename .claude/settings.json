      "Bash(node -e \"let d='';process.stdin.on\\('data',c=>d+=c\\).on\\('end',\\(\\)=>{const j=JSON.parse\\(d\\);console.log\\('tracks:',j.tracks.length,'| hasTarget:',j.target.hasTarget,'| all is_target=1?',j.tracks.every\\(t=>t.is_target===1\\)\\);}\\)\")",
