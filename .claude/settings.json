      "Bash(node -e \"let d='';process.stdin.on\\('data',c=>d+=c\\).on\\('end',\\(\\)=>{const t=JSON.parse\\(d\\).tracks;const tgt=t.filter\\(x=>x.is_target===1\\).length;console.log\\('total:',t.length,'| target:',tgt,'| comparison:',t.length-tgt\\);console.log\\('--- top 5 \\(combined, view desc\\) ---'\\);t.slice\\(0,5\\).forEach\\(\\(x,i\\)=>console.log\\(\\(i+1\\)+'.',x.is_target?'[대상]':'[비교]',x.view_count.toLocaleString\\(\\),'-',x.title.slice\\(0,40\\)\\)\\);}\\)\")"
